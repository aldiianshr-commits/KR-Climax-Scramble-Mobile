<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kr_bg"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="28dp">

    <!-- Left: game hero -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.06"
                android:text="@string/kr_title"
                android:textColor="@color/kr_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kr_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/kr_subtitle"
                android:textColor="@color/kr_text_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/kr_hero_bg"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="26dp"
                android:paddingEnd="26dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/kr_game_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/kr_loading"
                    android:textColor="@color/kr_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/kr_game_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/kr_text_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/kr_game_program"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/kr_text_dim"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_play"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="22dp"
                    android:enabled="false"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.2"
                    android:text="@string/kr_play"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/kr_red"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconSize="30dp" />

                <TextView
                    android:id="@+id/kr_play_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/kr_amber"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kr_choose_game"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kr_choose_game"
                        android:textColor="@color/kr_text"
                        app:icon="@drawable/ic_cartridge_outline"
                        app:iconTint="@color/kr_text_dim" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kr_rescan"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kr_rescan"
                        android:textColor="@color/kr_text"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="@color/kr_text_dim" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kr_advanced"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kr_advanced"
                        android:textColor="@color/kr_text"
                        app:icon="@drawable/ic_options"
                        app:iconTint="@color/kr_text_dim" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/kr_preset_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/kr_text_dim"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/kr_footer"
                android:textColor="#6B717C"
                android:textSize="11.5sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Right: setup checklist + settings -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="28dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                style="@style/KrSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/kr_section_setup" />

            <LinearLayout
                android:id="@+id/kr_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/KrSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kr_section_settings" />

            <GridLayout
                android:id="@+id/kr_settings_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_preset"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_preset"
                    app:icon="@drawable/ic_frames" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_graphics"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_graphics"
                    app:icon="@drawable/ic_graphics" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_gamepad"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_gamepad"
                    app:icon="@drawable/ic_controller" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_touch"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_touch"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_overlay"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_overlay"
                    app:icon="@drawable/ic_overlay" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_audio"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_audio"
                    app:icon="@drawable/ic_audio" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_system"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_system"
                    app:icon="@drawable/ic_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kr_btn_logs"
                    style="@style/KrTile"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kr_set_logs"
                    app:icon="@drawable/ic_log" />
            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
